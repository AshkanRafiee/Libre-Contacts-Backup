    <string name="category_contact_info_title">Información de contacto</string>
    <string name="category_contact_info_description">Nombres, números de teléfono, correos, direcciones, organizaciones, notas, cumpleaños y otros campos habituales de contacto.</string>
    <string name="category_contact_info_example">p. ej. «Juan Pérez · +34 612 34 56 78 · juan@ejemplo.com»</string>

